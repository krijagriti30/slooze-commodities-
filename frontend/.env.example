# Frontend (placeholders only; nothing here is a secret)
# Server-only: where this Next.js server proxies /api/graphql and fetches the session. Read at BUILD time for the rewrite.
BACKEND_GRAPHQL_URL=http://localhost:4000/graphql
# Optional: set only if the browser should call the API directly (needs CORS + SameSite=None cookies on the backend).
# Leave unset to use the same-origin proxy at /api/graphql.
# NEXT_PUBLIC_GRAPHQL_URL=
